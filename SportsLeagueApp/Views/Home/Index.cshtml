@inject SportsLeagueApp.Data.AppDbContext _context
@using Microsoft.EntityFrameworkCore

@{
    ViewData["Title"] = "Головна";
    var recentTeams = _context.Teams.OrderByDescending(t => t.Id).Take(5).ToList();
}
<div class="container py-4">
    <div class="mb-5">
        <h1 class="fw-bold mb-2" style="font-size: 2.5rem;">Головна</h1>
        <p class="text-secondary fs-5 mb-1">Керуйте командами та гравцями спортивної ліги</p>
        <p class="text-muted">Оберіть розділ, щоб переглянути або змінити дані.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card h-100 border rounded-3 p-3 shadow-none bg-white" style="border-color: #dee2e6 !important;">
                <div class="card-body d-flex flex-column justify-content-between p-2">
                    <div>
                        <h3 class="fw-bold fs-4 mb-2">Команди</h3>
                        <p class="text-secondary mb-4">Список команд, їх міста та стадіони</p>
                    </div>
                    <div>
                        <a href="/Teams" class="text-decoration-none text-dark fw-medium">Перейти до команд &rarr;</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border rounded-3 p-3 shadow-none bg-white" style="border-color: #dee2e6 !important;">
                <div class="card-body d-flex flex-column justify-content-between p-2">
                    <div>
                        <h3 class="fw-bold fs-4 mb-2">Гравці</h3>
                        <p class="text-secondary mb-4">Профілі гравців та їхні ігрові номери</p>
                    </div>
                    <div>
                        <a href="/Players" class="text-decoration-none text-dark fw-medium">Перейти до гравців &rarr;</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <h3 class="fw-bold fs-4 mb-3">Нещодавно додані команди</h3>
        <div class="table-responsive border rounded-3 bg-white">
            <table class="table table-bordered mb-0 align-middle">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="py-3 px-4 fw-semibold text-dark">Назва команди</th>
                        <th class="py-3 px-4 fw-semibold text-dark">Місто</th>
                        <th class="py-3 px-4 fw-semibold text-dark">Тренер</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentTeams.Any())
                    {
                        foreach (var team in recentTeams)
                        {
                            <tr style="cursor: pointer;" onclick="window.location.href='@Url.Action("Details", "Teams", new { id = team.Id })'" class="position-relative">
                                <td class="py-3 px-4 fw-medium text-dark">
                                    <a asp-controller="Teams" asp-action="Details" asp-route-id="@team.Id" class="text-decoration-none text-dark stretched-link">
                                        @team.Name
                                    </a>
                                </td>
                                <td class="py-3 px-4 text-dark">@team.City</td>
                                <td class="py-3 px-4 text-dark">@team.CoachName</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">Ще немає доданих команд. Створіть першу у розділі "Команди"!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>