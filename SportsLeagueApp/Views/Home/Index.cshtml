@inject SportsLeagueApp.Data.AppDbContext _context
@using Microsoft.EntityFrameworkCore

@{
    ViewData["Title"] = "Дашборд";

    var teamsList = _context.Teams.Include(t => t.Players).OrderByDescending(t => t.Id).ToList();
    var totalTeams = teamsList.Count;
    var totalPlayers = _context.Players.Count();

    var activeRosters = teamsList.Count(t =>
    {
        if (t.Players == null) return false;
        int playerCount = t.Players.Count;
        int requiredPlayers = 5;

        if (!string.IsNullOrWhiteSpace(t.SportCategory))
        {
            var sport = t.SportCategory.ToLower();
            if (sport.Contains("футбол") && !sport.Contains("міні") && !sport.Contains("футзал")) requiredPlayers = 11;
            else if (sport.Contains("баскетбол")) requiredPlayers = 5;
            else if (sport.Contains("волейбол") || sport.Contains("хокей")) requiredPlayers = 6;
            else if (sport.Contains("теніс")) requiredPlayers = 1;
        }
        return playerCount >= requiredPlayers;
    });

    var uniqueSports = teamsList
        .Where(t => !string.IsNullOrEmpty(t.SportCategory))
        .Select(t => t.SportCategory!)
        .Distinct()
        .ToList();

    var recentTeams = teamsList.Take(5).ToList();
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card border-0 rounded-4 p-4 shadow-sm bg-white h-100 d-flex flex-row align-items-center">
            <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 60px; height: 60px; background-color: #e0edff; color: #1a56db;">
                <i class="bi bi-people-fill fs-3"></i>
            </div>
            <div class="ms-3">
                <p class="text-secondary mb-1 fw-medium">Команди</p>
                <h2 class="fw-bold m-0" style="color: #111827;">@totalTeams</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 rounded-4 p-4 shadow-sm bg-white h-100 d-flex flex-row align-items-center">
            <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 60px; height: 60px; background-color: #e0f5f3; color: #0f766e;">
                <i class="bi bi-person-badge fs-3"></i>
            </div>
            <div class="ms-3">
                <p class="text-secondary mb-1 fw-medium">Гравці</p>
                <h2 class="fw-bold m-0" style="color: #111827;">@totalPlayers</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 rounded-4 p-4 shadow-sm bg-white h-100 d-flex flex-row align-items-center">
            <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 60px; height: 60px; background-color: #e0edff; color: #1a56db;">
                <i class="bi bi-person-lines-fill fs-3"></i>
            </div>
            <div class="ms-3">
                <p class="text-secondary mb-1 fw-medium">Активні склади</p>
                <h2 class="fw-bold m-0" style="color: #111827;">@activeRosters</h2>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card border-0 rounded-4 h-100" style="background-color: #f0f6ff;">
            <div class="card-body d-flex align-items-center p-4">
                <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 70px; height: 70px; background-color: #e0edff; color: #1a56db;">
                    <i class="bi bi-people-fill fs-2"></i>
                </div>
                <div class="ms-4">
                    <h4 class="fw-bold mb-1" style="color: #111827;">Команди</h4>
                    <p class="text-secondary mb-3 small">Перегляд та керування командами ліги</p>
                    <a href="/Teams" class="btn text-white px-4 py-2 rounded-3 fw-medium" style="background-color: #1a56db;">Відкрити розділ &rarr;</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 rounded-4 h-100" style="background-color: #f0fbfa;">
            <div class="card-body d-flex align-items-center p-4">
                <div class="rounded-circle d-flex justify-content-center align-items-center" style="width: 70px; height: 70px; background-color: #e0f5f3; color: #0f766e;">
                    <i class="bi bi-person-badge fs-2"></i>
                </div>
                <div class="ms-4">
                    <h4 class="fw-bold mb-1" style="color: #111827;">Гравці</h4>
                    <p class="text-secondary mb-3 small">Профілі, позиції та належність до команди</p>
                    <a href="/Players" class="btn text-white px-4 py-2 rounded-3 fw-medium" style="background-color: #0f766e;">Відкрити розділ &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mb-5">
    <h5 class="fw-bold mb-3" style="color: #111827;">Види спорту у лізі</h5>
    <div class="d-flex flex-wrap gap-2" id="sport-filters">
        <span class="badge rounded-pill fw-medium border px-3 py-2 sport-tag active" data-sport="all" style="cursor: pointer; font-size: 0.9rem; background-color: #111827; color: white;">Усі</span>
        @if (uniqueSports.Any())
        {
            foreach (var sport in uniqueSports)
            {
                <span class="badge rounded-pill fw-medium border px-3 py-2 sport-tag" data-sport="@sport" style="cursor: pointer; background-color: #ffffff; color: #495057; font-size: 0.9rem;">@sport</span>
            }
        }
    </div>
</div>

<div class="mb-4">
    <h5 class="fw-bold mb-3" style="color: #111827;">Нещодавно додані команди</h5>
    <div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden p-2">
        <div class="table-responsive">
            <table class="table align-middle mb-0 border-0 table-hover">
                <thead style="background-color: #ffffff;">
                    <tr>
                        <th class="py-3 px-4 text-secondary fw-semibold border-bottom-0">Команда</th>
                        <th class="py-3 px-4 text-secondary fw-semibold border-bottom-0 text-center">Спорт</th>
                        <th class="py-3 px-4 text-secondary fw-semibold border-bottom-0 text-center">Місто</th>
                        <th class="py-3 px-4 text-secondary fw-semibold border-bottom-0 text-center">Гравців</th>
                        <th class="py-3 px-4 text-secondary fw-semibold border-bottom-0 text-center">Тренер</th>
                        
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <th class="py-3 px-4 text-secondary fw-semibold border-bottom-0 text-center">Дії</th>
                        }
                    </tr>
                </thead>
                <tbody id="teams-table-body">
                    @if (recentTeams.Any())
                    {
                        foreach (var team in recentTeams)
                        {
                            string sportIcon = "fa-solid fa-trophy";
                            string iconBg = "#f1f5f9";
                            string iconColor = "#64748b";

                            if (!string.IsNullOrEmpty(team.SportCategory))
                            {
                                var s = team.SportCategory.ToLower();
                                if (s.Contains("футбол"))
                                {
                                    sportIcon = "fa-solid fa-futbol";
                                    iconBg = "#d1fae5";
                                    iconColor = "#059669";
                                }
                                else if (s.Contains("баскетбол"))
                                {
                                    sportIcon = "fa-solid fa-basketball";
                                    iconBg = "#ffedd5";
                                    iconColor = "#ea580c";
                                }
                                else if (s.Contains("волейбол"))
                                {
                                    sportIcon = "fa-solid fa-volleyball";
                                    iconBg = "#dbeafe";
                                    iconColor = "#2563eb";
                                }
                                else if (s.Contains("хокей"))
                                {
                                    sportIcon = "fa-solid fa-hockey-puck";
                                    iconBg = "#f3e8ff";
                                    iconColor = "#9333ea";
                                }
                            }

                            <tr class="team-row border-top"
                                data-sport="@(team.SportCategory ?? "")"
                                style="cursor: pointer;"
                                onclick="goToDetails(event, '/Teams/Details/@team.Id')">

                                <td class="py-3 px-4 border-light">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle me-3 d-flex justify-content-center align-items-center shadow-sm" style="width: 42px; height: 42px; background-color: @iconBg; color: @iconColor;">
                                            <i class="@sportIcon fs-5"></i>
                                        </div>
                                        <span class="fw-medium text-dark" style="font-size: 1.05rem;">@team.Name</span>
                                    </div>
                                </td>

                                <td class="py-3 px-4 border-light text-secondary text-center">@(string.IsNullOrEmpty(team.SportCategory) ? "—" : team.SportCategory)</td>
                                <td class="py-3 px-4 border-light text-secondary text-center">@(string.IsNullOrEmpty(team.City) ? "—" : team.City)</td>
                                <td class="py-3 px-4 border-light text-secondary text-center">
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill shadow-sm">@(team.Players?.Count ?? 0)</span>
                                </td>
                                <td class="py-3 px-4 border-light text-secondary text-center">@(string.IsNullOrEmpty(team.CoachName) ? "—" : team.CoachName)</td>

                                <!-- Кнопки дій -->
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <td class="py-3 px-4 border-light text-center">
                                        <div class="d-flex justify-content-center align-items-center gap-4">
                                            <a href="/Teams/Edit/@team.Id" class="text-primary text-decoration-none action-btn" title="Редагувати">
                                                <i class="bi bi-pencil" style="font-size: 1.3rem;"></i>
                                            </a>
                                            <!-- Видалення доступне лише для Адміна -->
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a href="/Teams/Delete/@team.Id" class="text-danger text-decoration-none action-btn" title="Видалити">
                                                    <i class="bi bi-trash3" style="font-size: 1.3rem;"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <!-- Динамічний colspan залежно від прав -->
                            <td colspan="@(User.IsInRole("Admin") || User.IsInRole("Manager") ? "6" : "5")" class="text-center py-5 text-muted">Немає жодної команди.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const tags = document.querySelectorAll('.sport-tag');
        const rows = document.querySelectorAll('.team-row');

        tags.forEach(tag => {
            tag.addEventListener('click', function() {
                tags.forEach(t => {
                    t.style.backgroundColor = '#ffffff';
                    t.style.color = '#495057';
                });
                this.style.backgroundColor = '#111827';
                this.style.color = 'white';

                const selectedSport = this.getAttribute('data-sport');

                rows.forEach(row => {
                    const rowSport = row.getAttribute('data-sport');
                    if (selectedSport === 'all' || rowSport === selectedSport) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        });
    });

    function goToDetails(event, url) {
        if (event.target.closest('a.action-btn')) {
            return;
        }
        window.location.href = url;
    }
</script>

<style>
    .table tbody tr:hover {
        background-color: #f8fafc;
    }

    .action-btn {
        transition: transform 0.2s ease, opacity 0.2s;
        opacity: 0.8;
    }

        .action-btn:hover {
            transform: scale(1.2);
            opacity: 1;
        }
</style>