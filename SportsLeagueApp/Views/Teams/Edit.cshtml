@model SportsLeagueApp.Models.Team

@{
    ViewData["Title"] = "Редагувати команду";
}

<div class="container py-4" style="max-width: 700px;">
    <h1 class="fw-bold mb-4" style="font-size: 2.2rem;">Редагувати команду</h1>

    <div class="card border rounded-3 p-4 shadow-none bg-white">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Назва команди</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="City" class="form-label fw-semibold">Місто</label>
                <input asp-for="City" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="CoachName" class="form-label fw-semibold">Тренер</label>
                <input asp-for="CoachName" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="FoundedYear" class="form-label fw-semibold">Рік заснування</label>
                <input asp-for="FoundedYear" class="form-control" type="number" />
            </div>

            <div class="mb-4">
                <label asp-for="HomeStadium" class="form-label fw-semibold">Домашній стадіон</label>
                <input asp-for="HomeStadium" class="form-control" />
            </div>

            <div class="d-flex align-items-center gap-3">
                <input type="submit" value="Зберегти зміни" class="btn btn-primary px-4 py-2" />
                <a asp-action="Index" class="text-decoration-none text-secondary">Назад до списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}