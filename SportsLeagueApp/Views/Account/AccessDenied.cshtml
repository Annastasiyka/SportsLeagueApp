@{
    ViewData["Title"] = "Доступ заборонено";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 rounded-4 shadow-sm text-center p-5">
                <div class="mb-4 text-danger">
                    <i class="bi bi-shield-lock-fill" style="font-size: 5rem;"></i>
                </div>
                <h2 class="fw-bold mb-3" style="color: #111827;">Доступ обмежено</h2>
                <p class="text-secondary mb-4">У вас немає достатньо прав для перегляду цієї сторінки або виконання цієї дії.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary px-4 py-2 rounded-3 fw-medium">
                    <i class="bi bi-arrow-left me-2"></i>Повернутися на головну
                </a>
            </div>
        </div>
    </div>
</div>