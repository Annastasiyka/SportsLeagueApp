@model IEnumerable<SportsLeagueApp.Models.UserRolesViewModel>
@{
    ViewData["Title"] = "Управління користувачами";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0" style="color: #111827;">Управління користувачами</h2>
    </div>

    <div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden p-2">
        <div class="table-responsive">
            <table class="table align-middle mb-0 border-0 table-hover">
                <thead style="background-color: #ffffff;">
                    <tr>
                        <th class="py-3 px-4 text-secondary fw-semibold border-bottom-0">Користувач (Email)</th>
                        <th class="py-3 px-4 text-secondary fw-semibold border-bottom-0">Поточні ролі</th>
                        <th class="py-3 px-4 text-secondary fw-semibold border-bottom-0 text-center">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr class="border-top">
                                <td class="py-3 px-4 border-light">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle me-3 d-flex justify-content-center align-items-center bg-light text-secondary shadow-sm" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person-fill fs-5"></i>
                                        </div>
                                        <span class="fw-medium text-dark">@user.Email</span>
                                    </div>
                                </td>
                                <td class="py-3 px-4 border-light">
                                    @if (user.Roles.Any())
                                    {
                                        foreach(var role in user.Roles)
                                        {
                                            string badgeColor = role == "Admin" ? "bg-danger" : (role == "Manager" ? "bg-primary" : "bg-dark");
                                            <span class="badge @badgeColor rounded-pill px-3 py-2 me-1 shadow-sm">@role</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Немає ролей</span>
                                    }
                                </td>
                                <td class="py-3 px-4 border-light text-center">
                                    <a asp-action="ManageRoles" asp-route-userId="@user.UserId" class="btn btn-sm btn-outline-primary rounded-3 px-3 py-2">
                                        <i class="bi bi-person-gear me-1"></i> Редагувати
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">Користувачів не знайдено.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>