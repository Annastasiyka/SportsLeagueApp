@model SportsLeagueApp.Models.ManageUserRolesViewModel
@{
    ViewData["Title"] = "Керування ролями";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 rounded-4 shadow-sm p-4">
                <div class="d-flex align-items-center mb-4">
                    <div class="rounded-circle me-3 d-flex justify-content-center align-items-center" style="width: 50px; height: 50px; background-color: #e0f5f3; color: #0f766e;">
                        <i class="bi bi-shield-check fs-4"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1" style="color: #111827;">Керування ролями</h3>
                        <p class="text-secondary mb-0 small">Користувач: <span class="fw-medium text-dark">@Model.Email</span></p>
                    </div>
                </div>

                <form asp-action="ManageRoles" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Email" />

                    <div class="bg-light rounded-4 p-4 mb-4">
                        <h5 class="fw-semibold text-dark mb-3">Оберіть рівень доступу:</h5>
                        
                        <div class="list-group list-group-flush border-0">
                            @for (int i = 0; i < Model.Roles.Count; i++)
                            {
                                <div class="list-group-item bg-transparent border-0 px-0 py-2">
                                    <div class="form-check form-switch fs-5 d-flex align-items-center m-0">
                                        <input type="hidden" asp-for="Roles[i].RoleName" />
                                        <input asp-for="Roles[i].IsSelected" class="form-check-input me-3 mt-0" style="cursor: pointer; width: 3em; height: 1.5em;" type="checkbox" role="switch" id="role_@i" />
                                        <label class="form-check-label text-dark fw-medium" style="cursor: pointer; padding-top: 2px;" for="role_@i">
                                            @Model.Roles[i].RoleName
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn px-4 py-2 rounded-3 fw-medium text-white" style="background-color: #0f766e;">
                            <i class="bi bi-check2-circle me-1"></i> Зберегти зміни
                        </button>
                        <a asp-action="Index" class="btn btn-light border px-4 py-2 rounded-3 fw-medium text-secondary">
                            Скасувати
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>