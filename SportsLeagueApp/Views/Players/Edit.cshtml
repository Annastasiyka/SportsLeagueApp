@model SportsLeagueApp.Models.Player

@{
    ViewData["Title"] = "Редагувати гравця";
}

<div class="container py-4" style="max-width: 700px;">
    <h1 class="fw-bold mb-4" style="font-size: 2.2rem;">Редагувати гравця</h1>

    @if (ViewBag.HasDraft == true)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center mb-4">
            <span>Знайдено незбережені зміни з минулого сеансу!</span>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-restoreDraft="true" class="btn btn-sm btn-primary me-2">Відновити зміни</a>
                <a asp-action="CancelEdit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger">Скинути</a>
            </div>
        </div>
    }

    <div class="card border rounded-3 p-4 shadow-none bg-white">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label fw-semibold">Ім'я</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label fw-semibold">Прізвище</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DateOfBirth" class="form-label fw-semibold">Дата народження</label>
                <input asp-for="DateOfBirth" class="form-control" type="date" />
                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Position" class="form-label fw-semibold">Позиція</label>
                <input asp-for="Position" class="form-control" />
                <span asp-validation-for="Position" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="JerseyNumber" class="form-label fw-semibold">Ігровий номер</label>
                <input asp-for="JerseyNumber" class="form-control" type="number" />
                <span asp-validation-for="JerseyNumber" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Команди</label>
                <select name="selectedTeams" class="form-select" multiple size="4">
                    @if (ViewBag.AllTeams != null)
                    {
                        foreach (var team in ViewBag.AllTeams)
                        {
                            bool isSelected = Model.Teams != null && Model.Teams.Any(t => t.Id == team.Id);

                            if (isSelected)
                            {
                                <option value="@team.Id" selected>@team.Name</option>
                            }
                            else
                            {
                                <option value="@team.Id">@team.Name</option>
                            }
                        }
                    }
                </select>
            </div>

            <div class="d-flex align-items-center gap-3">
                <input type="submit" value="Зберегти зміни" class="btn btn-primary px-4 py-2" />
                <a asp-action="CancelEdit" asp-route-id="@Model.Id" class="text-decoration-none text-secondary">Скасувати</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}