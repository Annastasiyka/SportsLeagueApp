@model SportsLeagueApp.Models.Player

@{
    ViewData["Title"] = "Видалити гравця";
}
<div class="container py-4" style="max-width: 700px;">
    <h1 class="fw-bold mb-3 text-danger" style="font-size: 2.2rem;">Видалити гравця</h1>
    <p class="text-secondary mb-4">Ви впевнені, що хочете видалити цього гравця?</p>

    <div class="card border rounded-3 p-4 shadow-none bg-white mb-4">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-secondary mb-3">ПІБ:</dt>
            <dd class="col-sm-8 fw-medium mb-3">@Model.FirstName @Model.LastName</dd>

            <dt class="col-sm-4 text-secondary mb-3">Позиція:</dt>
            <dd class="col-sm-8 fw-medium mb-3">@Model.Position</dd>

            <dt class="col-sm-4 text-secondary mb-3">Номер:</dt>
            <dd class="col-sm-8 fw-medium mb-3">@Model.JerseyNumber</dd>

            <dt class="col-sm-4 text-secondary mb-0">Команди:</dt>
            <dd class="col-sm-8 fw-medium mb-0">
                @if (Model.Teams != null && Model.Teams.Any())
                {
                    @string.Join(", ", Model.Teams.Select(t => t.Name))
                }
                else
                {
                    <span class="text-muted">Вільний агент</span>
                }
            </dd>
        </dl>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex align-items-center gap-3">
            <input type="submit" value="Видалити" class="btn btn-danger px-4 py-2" />
            <a asp-action="Index" class="text-decoration-none text-secondary">Скасувати</a>
        </div>
    </form>
</div>