@model SportsLeagueApp.Models.Player

@{
    ViewData["Title"] = "Додати гравця";
}

<div class="container py-4" style="max-width: 850px;">
    <div class="mb-4">
        <h1 class="fw-bold mb-1" style="color: #111827; font-size: 2rem;">Новий гравець</h1>
        <p class="text-secondary m-0">Заповніть профіль та призначте гравця до команди</p>
    </div>

    @if (ViewBag.HasDraft == true)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center mb-4">
            <span>Знайдено незбережені дані додавання гравця!</span>
            <div>
                <a asp-action="Create" asp-route-restoreDraft="true" class="btn btn-sm btn-primary me-2">Відновити</a>
                <a asp-action="CancelCreate" class="btn btn-sm btn-outline-danger">Очистити</a>
            </div>
        </div>
    }

    <div class="card border-0 rounded-4 p-4 shadow-sm bg-white">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-medium"></div>

            <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom" style="font-size: 1.1rem;">Особисті дані</h5>
            
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label fw-semibold text-secondary small">Ім'я</label>
                    <input asp-for="FirstName" class="form-control rounded-3" placeholder="Введіть ім'я..." />
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label fw-semibold text-secondary small">Прізвище</label>
                    <input asp-for="LastName" class="form-control rounded-3" placeholder="Введіть прізвище..." />
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="DateOfBirth" class="form-label fw-semibold text-secondary small">Дата народження</label>
                    <input asp-for="DateOfBirth" class="form-control rounded-3" type="date" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SportCategory" class="form-label fw-semibold text-secondary small">Вид спорту</label>
                    <select asp-for="SportCategory" id="playerSportSelect" class="form-select rounded-3" onchange="filterTeamsBySport()">
                        <option value="">-- Виберіть вид спорту --</option>
                        <option value="Футбол">Футбол</option>
                        <option value="Баскетбол">Баскетбол</option>
                        <option value="Волейбол">Волейбол</option>
                        <option value="Хокей">Хокей</option>
                    </select>
                    <span asp-validation-for="SportCategory" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Position" class="form-label fw-semibold text-secondary small">Позиція</label>
                    <input asp-for="Position" class="form-control rounded-3" placeholder="Наприклад: Захисник" />
                    <span asp-validation-for="Position" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="JerseyNumber" class="form-label fw-semibold text-secondary small">Ігровий номер</label>
                    <input asp-for="JerseyNumber" class="form-control rounded-3" type="number" placeholder="10" />
                    <span asp-validation-for="JerseyNumber" class="text-danger small"></span>
                </div>
            </div>

            <h5 class="fw-bold text-dark mb-3 pt-2 pb-2 border-bottom" style="font-size: 1.1rem;">Участь у команді</h5>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-semibold text-secondary small m-0">Команди (відповідного виду спорту)</label>
                    <a href="/Teams/Create" target="_blank" class="text-decoration-none small fw-medium" style="color: #0c615a;">+ Створити нову команду</a>
                </div>

                <div class="border rounded-3 p-3 bg-light" style="max-height: 180px; overflow-y: auto;">
                    @if (ViewBag.AllTeams != null)
                    {
                        foreach (var team in ViewBag.AllTeams)
                        {
                            bool isSelected = Model.Teams != null && Model.Teams.Any(t => t.Id == team.Id);
                            <div class="form-check mb-2 team-checkbox-item" data-team-sport="@team.SportCategory">
                                <input class="form-check-input" type="checkbox" name="selectedTeams" value="@team.Id" id="team_@team.Id" @(isSelected ? "checked" : "")>
                                <label class="form-check-label text-dark" for="team_@team.Id" style="cursor: pointer;">
                                    @team.Name <span class="text-muted small">(@team.City - <strong>@team.SportCategory</strong>)</span>
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small text-center py-2">У системі ще немає команд.</div>
                    }
                </div>
                <small id="noTeamsWarning" class="text-muted mt-1 d-none">Оберіть вид спорту гравця, щоб побачити доступні команди.</small>
            </div>

            <div class="d-flex align-items-center justify-content-end gap-3 pt-3 border-top">
                <a asp-action="CancelCreate" class="text-decoration-none text-secondary fw-medium">Скасувати</a>
                <input type="submit" value="Зберегти гравця" class="btn text-white px-4 py-2 rounded-3 fw-medium shadow-sm" style="background-color: #0c615a; border: none;" />
            </div>
        </form>
    </div>
</div>

<script>
    function filterTeamsBySport() {
        const selectedSport = document.getElementById('playerSportSelect').value;
        const teamItems = document.querySelectorAll('.team-checkbox-item');
        const warning = document.getElementById('noTeamsWarning');
        let visibleCount = 0;

        teamItems.forEach(item => {
            const teamSport = item.getAttribute('data-team-sport');
            if (!selectedSport) {
                item.style.display = 'block';
                visibleCount++;
            } else if (teamSport === selectedSport) {
                item.style.display = 'block';
                visibleCount++;
            } else {
                item.style.display = 'none';
                const checkbox = item.querySelector('input[type="checkbox"]');
                if (checkbox) checkbox.checked = false;
            }
        });

        if (!selectedSport) {
            warning.textContent = "Будь ласка, оберіть вид спорту гравця.";
            warning.classList.remove('d-none');
        } else if (visibleCount === 0) {
            warning.textContent = "Немає команд для цього виду спорту.";
            warning.classList.remove('d-none');
        } else {
            warning.classList.add('d-none');
        }
    }
    document.addEventListener("DOMContentLoaded", filterTeamsBySport);
</script>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}