@model SportsLeagueApp.Models.Player

@{
    ViewData["Title"] = "Додати гравця";
}

<div class="container py-4" style="max-width: 700px;">
    <h1 class="fw-bold mb-4" style="font-size: 2.2rem;">Додати гравця</h1>

    <div class="card border rounded-3 p-4 shadow-none bg-white">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label fw-semibold">Ім'я</label>
                <input asp-for="FirstName" class="form-control" placeholder="Введіть ім'я..." />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label fw-semibold">Прізвище</label>
                <input asp-for="LastName" class="form-control" placeholder="Введіть прізвище..." />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DateOfBirth" class="form-label fw-semibold">Дата народження</label>
                <input asp-for="DateOfBirth" class="form-control" type="date" />
            </div>

            <div class="mb-3">
                <label asp-for="Position" class="form-label fw-semibold">Позиція</label>
                <input asp-for="Position" class="form-control" placeholder="Наприклад: Захисник" />
            </div>

            <div class="mb-4">
                <label asp-for="JerseyNumber" class="form-label fw-semibold">Ігровий номер</label>
                <input asp-for="JerseyNumber" class="form-control" type="number" placeholder="10" />
            </div>

            <div class="d-flex align-items-center gap-3">
                <input type="submit" value="Додати" class="btn btn-primary px-4 py-2" />
                <a asp-action="Index" class="text-decoration-none text-secondary">Скасувати</a>
            </div>
        </form>
    </div>
</div>