@model IEnumerable<SportsLeagueApp.Models.Player>

@{
    ViewData["Title"] = "Гравці";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold m-0" style="font-size: 2.5rem;">Гравці</h1>
        <a asp-action="Create" class="btn btn-primary px-4 py-2">Додати гравця</a>
    </div>

    <div class="table-responsive border rounded-3 bg-white mb-4">
        <table class="table mb-0 align-middle">
            <thead class="table-light border-bottom">
                <tr>
                    <th class="py-3 px-4 fw-semibold text-dark">Ім'я та прізвище</th>
                    <th class="py-3 px-4 fw-semibold text-dark">Позиція</th>
                    <th class="py-3 px-4 fw-semibold text-dark">Номер</th>
                    <th class="py-3 px-4 fw-semibold text-dark">Дата народження</th>
                    <th class="py-3 px-4 fw-semibold text-dark text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="py-3 px-4 fw-medium">@item.FirstName @item.LastName</td>
                            <td class="py-3 px-4">@item.Position</td>
                            <td class="py-3 px-4">@item.JerseyNumber</td>
                            <td class="py-3 px-4">@item.DateOfBirth.ToString("dd.MM.yyyy")</td>
                            <td class="py-3 px-4 text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none me-2">Деталі</a> |
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-decoration-none mx-2">Редагувати</a> |
                                <a asp-action="Delete" asp-route-id="@item.Id" class="text-decoration-none text-danger ms-2">Видалити</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Ще немає доданих гравців.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div>
        <a href="/Home" class="text-decoration-none text-primary">&larr; На головну</a>
    </div>
</div>