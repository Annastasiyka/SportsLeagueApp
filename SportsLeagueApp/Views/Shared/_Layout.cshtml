<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Спортивна Ліга</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
            body {
                background-color: #f8f9fa;
                font-family: 'Segoe UI', Roboto, sans-serif;
            }

            .navbar {
                background-color: #ffffff;
                border-bottom: 1px solid #e5e9f2;
            }

            .navbar-brand {
                font-weight: 700;
                color: #1a233a !important;
                font-size: 1.8rem;
            }

            .content-wrapper {
                max-width: 1150px;
                margin: 0 auto;
            }

            .btn-login {
                background-color: #ffffff;
                border: 1px solid #cbd5e1;
                color: #475569;
                transition: all 0.3s ease;
            }

                .btn-login:hover {
                    background-color: #0f766e;
                    border-color: #0f766e;
                    color: #ffffff;
                }

            .btn-register {
                background-color: #0f766e;
                border: 1px solid #0f766e;
                color: #ffffff;
                transition: all 0.3s ease;
            }

                .btn-register:hover {
                    background-color: #149d92;
                    border-color: #149d92;
                    color: #ffffff;
                }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md py-3 shadow-sm">
            <div class="container-fluid px-4 px-lg-5 d-flex justify-content-between align-items-center">
                <a class="navbar-brand m-0" asp-controller="Home" asp-action="Index">Спортивна ліга</a>

                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <div class="d-flex align-items-center" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                                <div class="bg-dark text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 36px; height: 36px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div class="d-flex flex-column align-items-start me-1">
                                    <span class="fw-semibold text-dark lh-1">@User.Identity.Name</span>
                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        @(User.IsInRole("Admin") ? "Адміністратор" : "Користувач")
                                    </small>
                                </div>
                                <i class="bi bi-chevron-down small text-secondary ms-1"></i>
                            </div>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3">

                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a asp-controller="Admin" asp-action="Index" class="dropdown-item fw-medium py-2 text-dark">
                                            <i class="bi bi-gear-fill me-2" style="color: #0f766e;"></i>Адмін-панель
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }

                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger fw-medium py-2">
                                            <i class="bi bi-box-arrow-right me-2"></i>Вийти з акаунта
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-login fw-medium rounded-3 px-4 py-2">Вхід</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-register fw-medium rounded-3 px-4 py-2">Реєстрація</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper py-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>